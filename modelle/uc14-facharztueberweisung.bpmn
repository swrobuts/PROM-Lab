<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc14" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc14">
    <bpmn:participant id="Pool_patient" name="Patientin / Patient" processRef="Process_patient" />
    <bpmn:participant id="Pool_hausarzt" name="Hausarztpraxis" processRef="Process_hausarzt" />
    <bpmn:participant id="Pool_facharzt" name="Facharztpraxis" processRef="Process_facharzt" />
    <bpmn:messageFlow id="Msg_pt1_hs" name="Vorstellung in der Praxis" sourceRef="pt1" targetRef="hs" />
    <bpmn:messageFlow id="Msg_ht2_pe1" name="Überweisungsschein" sourceRef="ht2" targetRef="pe1" />
    <bpmn:messageFlow id="Msg_pt2_fs" name="Terminanfrage" sourceRef="pt2" targetRef="fs" />
    <bpmn:messageFlow id="Msg_ft2_pe2" name="Terminbestätigung" sourceRef="ft2" targetRef="pe2" />
    <bpmn:messageFlow id="Msg_ft4_he1" name="Befundbericht" sourceRef="ft4" targetRef="he1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_patient" name="Patientin / Patient" isExecutable="false">
    <bpmn:startEvent id="ps" name="Beschwerden">
      <bpmn:outgoing>Flow_ps_pt1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pt1" name="Hausarzt aufsuchen">
      <bpmn:incoming>Flow_ps_pt1</bpmn:incoming>
      <bpmn:outgoing>Flow_pt1_pe1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="pe1" name="Überweisung erhalten">
      <bpmn:incoming>Flow_pt1_pe1</bpmn:incoming>
      <bpmn:outgoing>Flow_pe1_pt2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="pt2" name="Termin beim Facharzt anfragen">
      <bpmn:incoming>Flow_pe1_pt2</bpmn:incoming>
      <bpmn:outgoing>Flow_pt2_pe2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="pe2" name="Termin erhalten">
      <bpmn:incoming>Flow_pt2_pe2</bpmn:incoming>
      <bpmn:outgoing>Flow_pe2_pt3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="pt3" name="Facharzttermin wahrnehmen">
      <bpmn:incoming>Flow_pe2_pt3</bpmn:incoming>
      <bpmn:outgoing>Flow_pt3_pend</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="pend" name="Untersuchung erfolgt">
      <bpmn:incoming>Flow_pt3_pend</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ps_pt1" sourceRef="ps" targetRef="pt1" />
    <bpmn:sequenceFlow id="Flow_pt1_pe1" sourceRef="pt1" targetRef="pe1" />
    <bpmn:sequenceFlow id="Flow_pe1_pt2" sourceRef="pe1" targetRef="pt2" />
    <bpmn:sequenceFlow id="Flow_pt2_pe2" sourceRef="pt2" targetRef="pe2" />
    <bpmn:sequenceFlow id="Flow_pe2_pt3" sourceRef="pe2" targetRef="pt3" />
    <bpmn:sequenceFlow id="Flow_pt3_pend" sourceRef="pt3" targetRef="pend" />
  </bpmn:process>
  <bpmn:process id="Process_hausarzt" name="Hausarztpraxis" isExecutable="false">
    <bpmn:startEvent id="hs" name="Patient erschienen">
      <bpmn:outgoing>Flow_hs_ht1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="ht1" name="Anamnese erheben">
      <bpmn:incoming>Flow_hs_ht1</bpmn:incoming>
      <bpmn:outgoing>Flow_ht1_ht2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="ht2" name="Überweisung ausstellen">
      <bpmn:incoming>Flow_ht1_ht2</bpmn:incoming>
      <bpmn:outgoing>Flow_ht2_he1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="he1" name="Facharztbefund eingegangen">
      <bpmn:incoming>Flow_ht2_he1</bpmn:incoming>
      <bpmn:outgoing>Flow_he1_ht3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="ht3" name="Befund in Patientenakte ablegen">
      <bpmn:incoming>Flow_he1_ht3</bpmn:incoming>
      <bpmn:outgoing>Flow_ht3_hend</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="hend" name="Fall dokumentiert">
      <bpmn:incoming>Flow_ht3_hend</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_hs_ht1" sourceRef="hs" targetRef="ht1" />
    <bpmn:sequenceFlow id="Flow_ht1_ht2" sourceRef="ht1" targetRef="ht2" />
    <bpmn:sequenceFlow id="Flow_ht2_he1" sourceRef="ht2" targetRef="he1" />
    <bpmn:sequenceFlow id="Flow_he1_ht3" sourceRef="he1" targetRef="ht3" />
    <bpmn:sequenceFlow id="Flow_ht3_hend" sourceRef="ht3" targetRef="hend" />
  </bpmn:process>
  <bpmn:process id="Process_facharzt" name="Facharztpraxis" isExecutable="false">
    <bpmn:startEvent id="fs" name="Terminanfrage eingegangen">
      <bpmn:outgoing>Flow_fs_ft1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="ft1" name="Termin einplanen">
      <bpmn:incoming>Flow_fs_ft1</bpmn:incoming>
      <bpmn:outgoing>Flow_ft1_ft2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="ft2" name="Termin mitteilen">
      <bpmn:incoming>Flow_ft1_ft2</bpmn:incoming>
      <bpmn:outgoing>Flow_ft2_ft3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="ft3" name="Patient untersuchen">
      <bpmn:incoming>Flow_ft2_ft3</bpmn:incoming>
      <bpmn:outgoing>Flow_ft3_ft4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="ft4" name="Befund an Hausarzt senden">
      <bpmn:incoming>Flow_ft3_ft4</bpmn:incoming>
      <bpmn:outgoing>Flow_ft4_fend</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="fend" name="Befund versandt">
      <bpmn:incoming>Flow_ft4_fend</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_fs_ft1" sourceRef="fs" targetRef="ft1" />
    <bpmn:sequenceFlow id="Flow_ft1_ft2" sourceRef="ft1" targetRef="ft2" />
    <bpmn:sequenceFlow id="Flow_ft2_ft3" sourceRef="ft2" targetRef="ft3" />
    <bpmn:sequenceFlow id="Flow_ft3_ft4" sourceRef="ft3" targetRef="ft4" />
    <bpmn:sequenceFlow id="Flow_ft4_fend" sourceRef="ft4" targetRef="fend" />
  </bpmn:process>
