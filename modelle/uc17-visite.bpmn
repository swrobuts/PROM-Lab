<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc17" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:process id="Process_uc17" name="Ärztliche Visite auf der Station" isExecutable="false">
    <bpmn:startEvent id="s1" name="Täglich 8:00 Uhr">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Patientenliste der Station abrufen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_sp1</bpmn:outgoing>
      <bpmn:property id="t1_prop0" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t1_din0">
        <bpmn:sourceRef>ds1</bpmn:sourceRef>
        <bpmn:targetRef>t1_prop0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:dataStoreReference id="ds1" name="Krankenhausinformationssystem" />
    <bpmn:subProcess id="sp1" name="Patient visitieren">
      <bpmn:documentation>Sequenzielle Mehrfachinstanz: je Patient auf der Liste ein Durchlauf, nacheinander.</bpmn:documentation>
      <bpmn:incoming>Flow_t1_sp1</bpmn:incoming>
      <bpmn:outgoing>Flow_sp1_t2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:subProcess>
    <bpmn:task id="t2" name="Befund in Patientenkurve eintragen">
      <bpmn:incoming>Flow_sp1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_g1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t2_dout0">
        <bpmn:targetRef>d1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="d1" name="Patientenkurve" dataObjectRef="d1_do" />
    <bpmn:dataObject id="d1_do" />
    <bpmn:exclusiveGateway id="g1" name="Medikation ändern?">
      <bpmn:incoming>Flow_t2_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_ca1</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_g2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="ca1" name="Medikation anpassen" calledElement="Process_medikation">
      <bpmn:documentation>Aufrufaktivität: verweist auf den eigenständigen Prozess „Medikation anpassen“, der auch aus der Notaufnahme aufgerufen wird.</bpmn:documentation>
      <bpmn:incoming>Flow_g1_ca1</bpmn:incoming>
      <bpmn:outgoing>Flow_ca1_g2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="g2">
      <bpmn:incoming>Flow_g1_g2</bpmn:incoming>
      <bpmn:incoming>Flow_ca1_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Visite mit Pflege nachbesprechen">
      <bpmn:incoming>Flow_g2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Visite abgeschlossen">
      <bpmn:incoming>Flow_t3_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_sp1" sourceRef="t1" targetRef="sp1" />
    <bpmn:sequenceFlow id="Flow_sp1_t2" sourceRef="sp1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_t2_g1" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_g1_ca1" name="ja" sourceRef="g1" targetRef="ca1" />
    <bpmn:sequenceFlow id="Flow_g1_g2" name="nein" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_ca1_g2" sourceRef="ca1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_g2_t3" sourceRef="g2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_t3_e1" sourceRef="t3" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_uc17">
    <bpmndi:BPMNPlane id="Plane_uc17" bpmnElement="Process_uc17">
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1">
        <dc:Bounds x="177" y="87" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="144" y="129" width="102" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="325" y="65" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ds1_di" bpmnElement="ds1">
        <dc:Bounds x="360" y="180" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="310" y="236" width="150" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sp1_di" bpmnElement="sp1" isExpanded="false">
        <dc:Bounds x="510" y="65" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="705" y="65" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d1_di" bpmnElement="d1">
        <dc:Bounds x="747" y="-15" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="789" y="3" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true">
        <dc:Bounds x="930" y="80" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="897" y="60" width="115" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ca1_di" bpmnElement="ca1">
        <dc:Bounds x="1085" y="195" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true">
        <dc:Bounds x="1310" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="1465" y="65" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1">
        <dc:Bounds x="1697" y="87" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1651" y="129" width="128" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_s1_t1_di" bpmnElement="Flow_s1_t1">
        <di:waypoint x="213" y="105" />
        <di:waypoint x="325" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_t1_sp1_di" bpmnElement="Flow_t1_sp1">
        <di:waypoint x="445" y="105" />
        <di:waypoint x="510" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_sp1_t2_di" bpmnElement="Flow_sp1_t2">
        <di:waypoint x="640" y="105" />
        <di:waypoint x="705" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_t2_g1_di" bpmnElement="Flow_t2_g1">
        <di:waypoint x="825" y="105" />
        <di:waypoint x="930" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g1_ca1_di" bpmnElement="Flow_g1_ca1">
        <di:waypoint x="955" y="130" />
        <di:waypoint x="955" y="235" />
        <di:waypoint x="1085" y="235" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="961" y="176" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g1_g2_di" bpmnElement="Flow_g1_g2">
        <di:waypoint x="980" y="105" />
        <di:waypoint x="1310" y="105" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1125" y="85" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ca1_g2_di" bpmnElement="Flow_ca1_g2">
        <di:waypoint x="1205" y="235" />
        <di:waypoint x="1335" y="235" />
        <di:waypoint x="1335" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g2_t3_di" bpmnElement="Flow_g2_t3">
        <di:waypoint x="1360" y="105" />
        <di:waypoint x="1465" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_t3_e1_di" bpmnElement="Flow_t3_e1">
        <di:waypoint x="1585" y="105" />
        <di:waypoint x="1697" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="t1_din0_di" bpmnElement="t1_din0">
        <di:waypoint x="385" y="180" />
        <di:waypoint x="385" y="145" />
