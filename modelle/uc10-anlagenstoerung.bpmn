<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc10" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:process id="Process_uc10" name="Fertigungsauftrag mit Anlagenstörung" isExecutable="false">
    <bpmn:startEvent id="s1" name="Fertigungsauftrag freigegeben">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Maschine rüsten">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Los fertigen">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="b1" name="Anlagenstörung" attachedToRef="t2">
      <bpmn:outgoing>Flow_b1_t4</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="t3" name="Los in Qualitätsprüfung geben">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Los fertiggestellt">
      <bpmn:incoming>Flow_t3_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t4" name="Instandhaltung rufen">
      <bpmn:incoming>Flow_b1_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e2" name="Auftrag abgebrochen">
      <bpmn:incoming>Flow_t4_e2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_t2_t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_t3_e1" sourceRef="t3" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_b1_t4" sourceRef="b1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_t4_e2" sourceRef="t4" targetRef="e2" />
  </bpmn:process>
