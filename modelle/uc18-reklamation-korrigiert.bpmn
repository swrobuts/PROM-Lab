<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc18k" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc18k">
    <bpmn:participant id="Pool_gast" name="Gast" processRef="Process_gast" />
    <bpmn:participant id="Pool_rest" name="Restaurant" processRef="Process_rest" />
    <bpmn:messageFlow id="Msg_gt1_rs" name="Reklamation" sourceRef="gt1" targetRef="rs" />
    <bpmn:messageFlow id="Msg_rt5_ge1" name="Ersatzgericht" sourceRef="rt5" targetRef="ge1" />
    <bpmn:messageFlow id="Msg_rt3_ge1" name="Gutschein" sourceRef="rt3" targetRef="ge1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gast" name="Gast" isExecutable="false">
    <bpmn:startEvent id="gs" name="Essen kalt serviert">
      <bpmn:outgoing>Flow_gs_gt1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="gt1" name="Gericht reklamieren">
      <bpmn:incoming>Flow_gs_gt1</bpmn:incoming>
      <bpmn:outgoing>Flow_gt1_ge1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="ge1" name="Ersatz oder Gutschein erhalten">
      <bpmn:incoming>Flow_gt1_ge1</bpmn:incoming>
      <bpmn:outgoing>Flow_ge1_ge</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ge" name="Reklamation erledigt">
      <bpmn:incoming>Flow_ge1_ge</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_gs_gt1" sourceRef="gs" targetRef="gt1" />
    <bpmn:sequenceFlow id="Flow_gt1_ge1" sourceRef="gt1" targetRef="ge1" />
    <bpmn:sequenceFlow id="Flow_ge1_ge" sourceRef="ge1" targetRef="ge" />
  </bpmn:process>
  <bpmn:process id="Process_rest" name="Restaurant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_rest">
      <bpmn:lane id="Lane_service" name="Service">
        <bpmn:flowNodeRef>rs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>re</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_kueche" name="Küche">
        <bpmn:flowNodeRef>rt2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="rs" name="Reklamation eingegangen">
      <bpmn:outgoing>Flow_rs_rt1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="rt1" name="Reklamation prüfen">
      <bpmn:incoming>Flow_rs_rt1</bpmn:incoming>
      <bpmn:outgoing>Flow_rt1_rg1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="rg1" name="Reklamation berechtigt?" default="Flow_rg1_rg2">
      <bpmn:incoming>Flow_rt1_rg1</bpmn:incoming>
      <bpmn:outgoing>Flow_rg1_rt2</bpmn:outgoing>
      <bpmn:outgoing>Flow_rg1_rt3</bpmn:outgoing>
      <bpmn:outgoing>Flow_rg1_rg2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="rt2" name="Gericht neu zubereiten">
      <bpmn:incoming>Flow_rg1_rt2</bpmn:incoming>
      <bpmn:outgoing>Flow_rt2_rt5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="rt5" name="Ersatzgericht servieren">
      <bpmn:incoming>Flow_rt2_rt5</bpmn:incoming>
      <bpmn:outgoing>Flow_rt5_rg2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="rt3" name="Gutschein ausstellen">
      <bpmn:incoming>Flow_rg1_rt3</bpmn:incoming>
      <bpmn:outgoing>Flow_rt3_rg2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="rg2">
      <bpmn:incoming>Flow_rg1_rg2</bpmn:incoming>
      <bpmn:incoming>Flow_rt5_rg2</bpmn:incoming>
      <bpmn:incoming>Flow_rt3_rg2</bpmn:incoming>
      <bpmn:outgoing>Flow_rg2_rt6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="rt6" name="Reklamation im Kassensystem vermerken">
      <bpmn:incoming>Flow_rg2_rt6</bpmn:incoming>
      <bpmn:outgoing>Flow_rt6_re</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="re" name="Reklamation bearbeitet">
      <bpmn:incoming>Flow_rt6_re</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_rs_rt1" sourceRef="rs" targetRef="rt1" />
    <bpmn:sequenceFlow id="Flow_rt1_rg1" sourceRef="rt1" targetRef="rg1" />
    <bpmn:sequenceFlow id="Flow_rg1_rt2" name="ja, Gericht kalt" sourceRef="rg1" targetRef="rt2" />
    <bpmn:sequenceFlow id="Flow_rg1_rt3" name="ja, Gericht nicht ersetzbar" sourceRef="rg1" targetRef="rt3" />
    <bpmn:sequenceFlow id="Flow_rg1_rg2" name="nein" sourceRef="rg1" targetRef="rg2" />
    <bpmn:sequenceFlow id="Flow_rt2_rt5" sourceRef="rt2" targetRef="rt5" />
    <bpmn:sequenceFlow id="Flow_rt5_rg2" sourceRef="rt5" targetRef="rg2" />
    <bpmn:sequenceFlow id="Flow_rt3_rg2" sourceRef="rt3" targetRef="rg2" />
    <bpmn:sequenceFlow id="Flow_rg2_rt6" sourceRef="rg2" targetRef="rt6" />
    <bpmn:sequenceFlow id="Flow_rt6_re" sourceRef="rt6" targetRef="re" />
  </bpmn:process>
