<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Entlassmanagement"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Krankenhaus" name="Krankenhaus" processRef="Process_Krankenhaus" />
    <bpmn:participant id="Participant_Sanitaetshaus" name="Sanitätshaus" />
    <bpmn:participant id="Participant_Hausarzt" name="Hausarzt" />
    <bpmn:participant id="Participant_Krankenkasse" name="Krankenkasse" />
    <bpmn:participant id="Participant_Patient" name="Patient" />

    <bpmn:messageFlow id="MessageFlow_1" name="Bestellung Hilfsmittel" sourceRef="Task_HilfsmittelBestellen" targetRef="Participant_Sanitaetshaus" />
    <bpmn:messageFlow id="MessageFlow_2" name="Lieferbestätigung" sourceRef="Participant_Sanitaetshaus" targetRef="Task_AufLieferbestaetigungWarten" />
    <bpmn:messageFlow id="MessageFlow_3" name="Entlassbrief &amp; Medikationsplan" sourceRef="Task_Entlassgespraech" targetRef="Participant_Patient" />
    <bpmn:messageFlow id="MessageFlow_4" name="Entlassbrief elektronisch" sourceRef="Task_BriefElektronischSenden" targetRef="Participant_Hausarzt" />
    <bpmn:messageFlow id="MessageFlow_5" name="Fallmeldung" sourceRef="Task_FallMelden" targetRef="Participant_Krankenkasse" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Krankenhaus" name="Entlassmanagement im Krankenhaus" isExecutable="false">

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Stationsaerztin" name="Stationsärztin">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Entlassbrief</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_XOR2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntlassungVerschieben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Entlassgespraech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BriefElektronischSenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pflege" name="Pflege">
        <bpmn:flowNodeRef>Task_HilfsmittelPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_XOR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_XOR1_Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sozialdienst" name="Sozialdienst">
        <bpmn:flowNodeRef>Task_HilfsmittelBestellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AufLieferbestaetigungWarten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_Timer1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TelefonischNachfassen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Abrechnung" name="Abrechnung">
        <bpmn:flowNodeRef>Task_FallMelden</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Visite: Entlassung möglich">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="Gateway_ParallelSplit1" name="">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_Entlassbrief" name="Entlassbrief erstellen">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_HilfsmittelPruefen" name="Hilfsmittelbedarf prüfen">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_XOR1" name="Hilfsmittel nötig?">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_HilfsmittelBestellen" name="Hilfsmittel beim Sanitätshaus bestellen">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:receiveTask id="Task_AufLieferbestaetigungWarten" name="Auf Lieferbestätigung warten">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:boundaryEvent id="BoundaryEvent_Timer1" name="24h abgelaufen" attachedToRef="Task_AufLieferbestaetigungWarten" cancelActivity="false">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_TelefonischNachfassen" name="Telefonisch nachfassen">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_XOR1_Join" name="">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gateway_ParallelJoin1" name="">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="Gateway_XOR2" name="Patient transportfähig?">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_EntlassungVerschieben" name="Entlassung um einen Tag verschieben">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Entlassgespraech" name="Entlassgespräch führen, Brief &amp; Medikationsplan übergeben">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_ParallelSplit2" name="">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="Task_BriefElektronischSenden" name="Entlassbrief elektronisch an Hausarzt senden">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_FallMelden" name="Fall an Krankenkasse melden">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:parallelGateway id="Gateway_ParallelJoin2" name="">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_1" name="Patient entlassen">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Gateway_ParallelSplit1" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Gateway_ParallelSplit1" targetRef="Task_Entlassbrief" />
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Gateway_ParallelSplit1" targetRef="Task_HilfsmittelPruefen" />
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_Entlassbrief" targetRef="Gateway_ParallelJoin1" />
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_HilfsmittelPruefen" targetRef="Gateway_XOR1" />
    <bpmn:sequenceFlow id="SequenceFlow_6" name="ja" sourceRef="Gateway_XOR1" targetRef="Task_HilfsmittelBestellen" />
    <bpmn:sequenceFlow id="SequenceFlow_7" name="nein" sourceRef="Gateway_XOR1" targetRef="Gateway_XOR1_Join" />
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_HilfsmittelBestellen" targetRef="Task_AufLieferbestaetigungWarten" />
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_AufLieferbestaetigungWarten" targetRef="Gateway_XOR1_Join" />
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="BoundaryEvent_Timer1" targetRef="Task_TelefonischNachfassen" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_TelefonischNachfassen" targetRef="Task_AufLieferbestaetigungWarten" />
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Gateway_XOR1_Join" targetRef="Gateway_ParallelJoin1" />
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Gateway_ParallelJoin1" targetRef="Gateway_XOR2" />
    <bpmn:sequenceFlow id="SequenceFlow_14" name="ja" sourceRef="Gateway_XOR2" targetRef="Task_Entlassgespraech" />
    <bpmn:sequenceFlow id="SequenceFlow_15" name="nein" sourceRef="Gateway_XOR2" targetRef="Task_EntlassungVerschieben" />
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_EntlassungVerschieben" targetRef="Gateway_ParallelSplit1" />
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_Entlassgespraech" targetRef="Gateway_ParallelSplit2" />
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Gateway_ParallelSplit2" targetRef="Task_BriefElektronischSenden" />
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Gateway_ParallelSplit2" targetRef="Task_FallMelden" />
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_BriefElektronischSenden" targetRef="Gateway_ParallelJoin2" />
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Task_FallMelden" targetRef="Gateway_ParallelJoin2" />
    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="Gateway_ParallelJoin2" targetRef="EndEvent_1" />

  </bpmn:process>

