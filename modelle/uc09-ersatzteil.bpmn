  <bpmn:process id="Process_uc09" name="Ersatzteilbestellung mit Fristüberwachung" isExecutable="false">
    <bpmn:startEvent id="s1" name="Ersatzteilbedarf gemeldet">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Bestellung beim Lieferanten auslösen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="g1">
      <bpmn:incoming>Flow_t1_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_e2</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_e3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="e2" name="Lieferbestätigung eingegangen">
      <bpmn:incoming>Flow_g1_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_e2_t2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e3" name="3 Werktage verstrichen">
      <bpmn:incoming>Flow_g1_e3</bpmn:incoming>
      <bpmn:outgoing>Flow_e3_t3</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t2" name="Liefertermin im System hinterlegen">
      <bpmn:incoming>Flow_e2_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Lieferanten telefonisch mahnen">
      <bpmn:incoming>Flow_e3_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_t4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Ersatzlieferant anfragen">
      <bpmn:incoming>Flow_t3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2">
      <bpmn:incoming>Flow_t2_g2</bpmn:incoming>
      <bpmn:incoming>Flow_t4_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_e4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="e4" name="Ware eingetroffen">
      <bpmn:incoming>Flow_g2_e4</bpmn:incoming>
      <bpmn:outgoing>Flow_e4_t5</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="Ersatzteil einlagern">
      <bpmn:incoming>Flow_e4_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Bedarf gedeckt">
      <bpmn:incoming>Flow_t5_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_g1" sourceRef="t1" targetRef="g1" />
