<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc15" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:process id="Process_uc15" name="Instandhaltungsauftrag an einer Abfüllanlage" isExecutable="false">
    <bpmn:startEvent id="s1" name="Störmeldung eingegangen">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:dataObjectReference id="d1" name="Störmeldung" dataObjectRef="d1_do" />
    <bpmn:dataObject id="d1_do" />
    <bpmn:task id="t1" name="Auftrag im Instandhaltungssystem anlegen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_sp1</bpmn:outgoing>
      <bpmn:property id="t1_prop0" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="t1_din0">
        <bpmn:sourceRef>d1</bpmn:sourceRef>
        <bpmn:targetRef>t1_prop0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="t1_dout0">
        <bpmn:targetRef>ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataStoreReference id="ds1" name="Instandhaltungssystem (CMMS)" />
    <bpmn:subProcess id="sp1" name="Störung diagnostizieren">
      <bpmn:incoming>Flow_t1_sp1</bpmn:incoming>
      <bpmn:outgoing>Flow_sp1_g1</bpmn:outgoing>
      <bpmn:startEvent id="c_s">
        <bpmn:outgoing>Flow_c_s_c_t1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="c_t1" name="Fehlerspeicher auslesen">
        <bpmn:incoming>Flow_c_s_c_t1</bpmn:incoming>
        <bpmn:outgoing>Flow_c_t1_c_t2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="c_t2" name="Anlage vor Ort inspizieren">
        <bpmn:incoming>Flow_c_t1_c_t2</bpmn:incoming>
        <bpmn:outgoing>Flow_c_t2_c_t3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="c_t3" name="Ursache eingrenzen">
        <bpmn:incoming>Flow_c_t2_c_t3</bpmn:incoming>
        <bpmn:outgoing>Flow_c_t3_c_e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="c_e">
        <bpmn:incoming>Flow_c_t3_c_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_c_s_c_t1" sourceRef="c_s" targetRef="c_t1" />
      <bpmn:sequenceFlow id="Flow_c_t1_c_t2" sourceRef="c_t1" targetRef="c_t2" />
      <bpmn:sequenceFlow id="Flow_c_t2_c_t3" sourceRef="c_t2" targetRef="c_t3" />
      <bpmn:sequenceFlow id="Flow_c_t3_c_e" sourceRef="c_t3" targetRef="c_e" />

    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="g1" name="Ersatzteil nötig?">
      <bpmn:incoming>Flow_sp1_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t2</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_g2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Ersatzteil aus Lager entnehmen">
      <bpmn:incoming>Flow_g1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2">
      <bpmn:incoming>Flow_g1_g2</bpmn:incoming>
      <bpmn:incoming>Flow_t2_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Anlage instand setzen">
      <bpmn:incoming>Flow_g2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_t4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Probelauf durchführen">
      <bpmn:incoming>Flow_t3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_t5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Instandhaltungsbericht erstellen">
      <bpmn:incoming>Flow_t4_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_e1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t5_dout0">
        <bpmn:targetRef>d2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="d2" name="Instandhaltungsbericht" dataObjectRef="d2_do" />
    <bpmn:dataObject id="d2_do" />
    <bpmn:endEvent id="e1" name="Anlage wieder verfügbar">
      <bpmn:incoming>Flow_t5_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_sp1" sourceRef="t1" targetRef="sp1" />
    <bpmn:sequenceFlow id="Flow_sp1_g1" sourceRef="sp1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_g1_t2" name="ja" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_g1_g2" name="nein" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_t2_g2" sourceRef="t2" targetRef="g2" />
