<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc21" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc21">
    <bpmn:participant id="Pool_sani" name="Sanitätshaus" />
    <bpmn:participant id="Pool_kh" name="Krankenhaus" processRef="Process_kh" />
    <bpmn:participant id="Pool_patient" name="Patient" />
    <bpmn:participant id="Pool_hausarzt" name="Hausarzt" />
    <bpmn:participant id="Pool_kasse" name="Krankenkasse" />
    <bpmn:messageFlow id="Msg_t3_sani" name="Bestellung" sourceRef="t3" targetRef="Pool_sani" />
    <bpmn:messageFlow id="Msg_sani_e2" name="Lieferbestätigung" sourceRef="Pool_sani" targetRef="e2" />
    <bpmn:messageFlow id="Msg_t6_patient" name="Entlassbrief, Medikationsplan" sourceRef="t6" targetRef="Pool_patient" />
    <bpmn:messageFlow id="Msg_t7_hausarzt" name="Entlassbrief (elektronisch)" sourceRef="t7" targetRef="Pool_hausarzt" />
    <bpmn:messageFlow id="Msg_t8_kasse" name="Fallmeldung" sourceRef="t8" targetRef="Pool_kasse" />
  </bpmn:collaboration>
  <bpmn:process id="Process_kh" name="Krankenhaus" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kh">
      <bpmn:lane id="Lane_arzt" name="Stationsärztin">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pflege" name="Pflege">
        <bpmn:flowNodeRef>t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sozial" name="Sozialdienst">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_abrechnung" name="Abrechnung">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Entlassfähigkeit bei Visite festgestellt">
      <bpmn:outgoing>Flow_s1_g0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g0" name="Patient transportfähig?">
      <bpmn:incoming>Flow_s1_g0</bpmn:incoming>
      <bpmn:outgoing>Flow_g0_t0</bpmn:outgoing>
      <bpmn:outgoing>Flow_g0_g1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t0" name="Entlassung um einen Tag verschieben">
      <bpmn:incoming>Flow_g0_t0</bpmn:incoming>
      <bpmn:outgoing>Flow_t0_e0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e0" name="Entlassung verschoben">
      <bpmn:documentation>Die Visite am Folgetag löst eine neue Instanz dieses Prozesses aus.</bpmn:documentation>
      <bpmn:incoming>Flow_t0_e0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="g1">
      <bpmn:incoming>Flow_g0_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t1</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t1" name="Entlassbrief erstellen">
      <bpmn:incoming>Flow_g1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_g5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Hilfsmittelbedarf prüfen">
      <bpmn:incoming>Flow_g1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Hilfsmittel nötig?">
      <bpmn:incoming>Flow_t2_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t3</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_g4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t3" name="Hilfsmittel beim Sanitätshaus bestellen">
      <bpmn:incoming>Flow_g2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_g3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="g3">
      <bpmn:incoming>Flow_t3_g3</bpmn:incoming>
      <bpmn:incoming>Flow_t4_g3</bpmn:incoming>
      <bpmn:outgoing>Flow_g3_e2</bpmn:outgoing>
      <bpmn:outgoing>Flow_g3_e3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="e2" name="Lieferbestätigung eingegangen">
      <bpmn:incoming>Flow_g3_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_e2_g4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e3" name="24 Stunden verstrichen">
      <bpmn:incoming>Flow_g3_e3</bpmn:incoming>
      <bpmn:outgoing>Flow_e3_t4</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t4" name="Beim Sanitätshaus telefonisch nachfassen">
      <bpmn:incoming>Flow_e3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g4">
      <bpmn:incoming>Flow_g2_g4</bpmn:incoming>
      <bpmn:incoming>Flow_e2_g4</bpmn:incoming>
      <bpmn:outgoing>Flow_g4_g5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="g5">
      <bpmn:incoming>Flow_t1_g5</bpmn:incoming>
      <bpmn:incoming>Flow_g4_g5</bpmn:incoming>
      <bpmn:outgoing>Flow_g5_t5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t5" name="Entlassgespräch führen">
      <bpmn:incoming>Flow_g5_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_t6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="t6" name="Entlassbrief und Medikationsplan übergeben">
      <bpmn:incoming>Flow_t5_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_g6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="g6">
      <bpmn:incoming>Flow_t6_g6</bpmn:incoming>
      <bpmn:outgoing>Flow_g6_t7</bpmn:outgoing>
      <bpmn:outgoing>Flow_g6_t8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="t7" name="Entlassbrief elektronisch an Hausarzt senden">
      <bpmn:incoming>Flow_g6_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t7_g7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="t8" name="Fall an Krankenkasse melden">
      <bpmn:incoming>Flow_g6_t8</bpmn:incoming>
      <bpmn:outgoing>Flow_t8_g7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="g7">
      <bpmn:incoming>Flow_t7_g7</bpmn:incoming>
      <bpmn:incoming>Flow_t8_g7</bpmn:incoming>
      <bpmn:outgoing>Flow_g7_e1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="e1" name="Patient entlassen">
      <bpmn:incoming>Flow_g7_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_g0" sourceRef="s1" targetRef="g0" />
    <bpmn:sequenceFlow id="Flow_g0_t0" name="nein" sourceRef="g0" targetRef="t0" />
    <bpmn:sequenceFlow id="Flow_t0_e0" sourceRef="t0" targetRef="e0" />
    <bpmn:sequenceFlow id="Flow_g0_g1" name="ja" sourceRef="g0" targetRef="g1" />
