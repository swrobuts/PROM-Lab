<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc13" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc13">
    <bpmn:participant id="Pool_spediteur" name="Spediteur" />
    <bpmn:participant id="Pool_logistik" name="Logistikzentrum" processRef="Process_logistik" />
    <bpmn:messageFlow id="Msg_spediteur_s1" name="Anmeldung mit Lieferschein" sourceRef="Pool_spediteur" targetRef="s1" />
    <bpmn:messageFlow id="Msg_t2_spediteur" name="Rampennummer" sourceRef="t2" targetRef="Pool_spediteur" />
  </bpmn:collaboration>
  <bpmn:process id="Process_logistik" name="Logistikzentrum" isExecutable="false">
    <bpmn:laneSet id="LaneSet_logistik">
      <bpmn:lane id="Lane_pforte" name="Pforte">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_we" name="Wareneingang">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_qs" name="Qualitätssicherung">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Lkw an der Pforte">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Lieferpapiere prüfen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Rampe zuweisen">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Lkw entladen">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_t4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Lieferung mit Bestellung abgleichen">
      <bpmn:incoming>Flow_t3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Abweichung?">
      <bpmn:incoming>Flow_t4_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t5</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t5" name="Abweichung an Einkauf melden">
      <bpmn:incoming>Flow_g1_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_e2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="t6" name="Stichprobe prüfen">
      <bpmn:incoming>Flow_g1_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Prüfung bestanden?">
      <bpmn:incoming>Flow_t6_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t7</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_g3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t7" name="Ware sperren">
      <bpmn:incoming>Flow_g2_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t7_e3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e3" name="Ware gesperrt">
      <bpmn:incoming>Flow_t7_e3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g3">
      <bpmn:incoming>Flow_g2_g3</bpmn:incoming>
      <bpmn:outgoing>Flow_g3_t8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t8" name="Ware einlagern">
      <bpmn:incoming>Flow_g3_t8</bpmn:incoming>
      <bpmn:outgoing>Flow_t8_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Ware verfügbar">
      <bpmn:incoming>Flow_t8_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Klärung angestoßen">
      <bpmn:incoming>Flow_t5_e2</bpmn:incoming>
    </bpmn:endEvent>
