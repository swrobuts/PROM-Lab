<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc12" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc12">
    <bpmn:participant id="Pool_gast" name="Gast" processRef="Process_gast" />
    <bpmn:participant id="Pool_restaurant" name="Restaurant" processRef="Process_restaurant" />
    <bpmn:messageFlow id="Msg_gt1_rs" name="Reservierungsanfrage" sourceRef="gt1" targetRef="rs" />
    <bpmn:messageFlow id="Msg_rt2_ge1" name="Bestätigung" sourceRef="rt2" targetRef="ge1" />
    <bpmn:messageFlow id="Msg_rt3_ge1" name="Absage" sourceRef="rt3" targetRef="ge1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gast" name="Gast" isExecutable="false">
    <bpmn:startEvent id="gs" name="Essenswunsch">
      <bpmn:outgoing>Flow_gs_gt1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="gt1" name="Reservierung anfragen">
      <bpmn:incoming>Flow_gs_gt1</bpmn:incoming>
      <bpmn:outgoing>Flow_gt1_ge1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="ge1" name="Antwort erhalten">
      <bpmn:incoming>Flow_gt1_ge1</bpmn:incoming>
      <bpmn:outgoing>Flow_ge1_gg1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gg1" name="Tisch frei?">
      <bpmn:incoming>Flow_ge1_gg1</bpmn:incoming>
      <bpmn:outgoing>Flow_gg1_gt2</bpmn:outgoing>
      <bpmn:outgoing>Flow_gg1_gend2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gt2" name="Restaurant besuchen">
      <bpmn:incoming>Flow_gg1_gt2</bpmn:incoming>
      <bpmn:outgoing>Flow_gt2_gend1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="gend1" name="Besuch erfolgt">
      <bpmn:incoming>Flow_gt2_gend1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="gend2" name="Alternative gesucht">
      <bpmn:incoming>Flow_gg1_gend2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_gs_gt1" sourceRef="gs" targetRef="gt1" />
    <bpmn:sequenceFlow id="Flow_gt1_ge1" sourceRef="gt1" targetRef="ge1" />
    <bpmn:sequenceFlow id="Flow_ge1_gg1" sourceRef="ge1" targetRef="gg1" />
    <bpmn:sequenceFlow id="Flow_gg1_gt2" name="bestätigt" sourceRef="gg1" targetRef="gt2" />
    <bpmn:sequenceFlow id="Flow_gg1_gend2" name="abgelehnt" sourceRef="gg1" targetRef="gend2" />
    <bpmn:sequenceFlow id="Flow_gt2_gend1" sourceRef="gt2" targetRef="gend1" />
  </bpmn:process>
  <bpmn:process id="Process_restaurant" name="Restaurant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_restaurant">
      <bpmn:lane id="Lane_service" name="Service">
        <bpmn:flowNodeRef>rs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rend2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rpg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rend1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_kueche" name="Küche">
        <bpmn:flowNodeRef>kt1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="rs" name="Anfrage eingegangen">
      <bpmn:outgoing>Flow_rs_rt1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="rt1" name="Belegung prüfen">
      <bpmn:incoming>Flow_rs_rt1</bpmn:incoming>
      <bpmn:outgoing>Flow_rt1_rg1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="rg1" name="Tisch frei?">
      <bpmn:incoming>Flow_rt1_rg1</bpmn:incoming>
      <bpmn:outgoing>Flow_rg1_rt2</bpmn:outgoing>
      <bpmn:outgoing>Flow_rg1_rt3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="rt2" name="Reservierung bestätigen">
      <bpmn:incoming>Flow_rg1_rt2</bpmn:incoming>
      <bpmn:outgoing>Flow_rt2_rpg1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="rt3" name="Absage senden">
      <bpmn:incoming>Flow_rg1_rt3</bpmn:incoming>
      <bpmn:outgoing>Flow_rt3_rend2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="rend2" name="Anfrage abgelehnt">
      <bpmn:incoming>Flow_rt3_rend2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="rt4" name="Tisch eindecken">
      <bpmn:incoming>Flow_rpg1_rt4</bpmn:incoming>
      <bpmn:outgoing>Flow_rt4_rpg2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="kt1" name="Reservierung in Tagesplanung aufnehmen">
      <bpmn:incoming>Flow_rpg1_kt1</bpmn:incoming>
      <bpmn:outgoing>Flow_kt1_rpg2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="rpg1">
      <bpmn:incoming>Flow_rt2_rpg1</bpmn:incoming>
      <bpmn:outgoing>Flow_rpg1_rt4</bpmn:outgoing>
      <bpmn:outgoing>Flow_rpg1_kt1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="rpg2">
      <bpmn:incoming>Flow_rt4_rpg2</bpmn:incoming>
      <bpmn:incoming>Flow_kt1_rpg2</bpmn:incoming>
      <bpmn:outgoing>Flow_rpg2_rend1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="rend1" name="Gast empfangen">
      <bpmn:incoming>Flow_rpg2_rend1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_rs_rt1" sourceRef="rs" targetRef="rt1" />
    <bpmn:sequenceFlow id="Flow_rt1_rg1" sourceRef="rt1" targetRef="rg1" />
    <bpmn:sequenceFlow id="Flow_rg1_rt2" name="ja" sourceRef="rg1" targetRef="rt2" />
    <bpmn:sequenceFlow id="Flow_rg1_rt3" name="nein" sourceRef="rg1" targetRef="rt3" />
    <bpmn:sequenceFlow id="Flow_rt3_rend2" sourceRef="rt3" targetRef="rend2" />
    <bpmn:sequenceFlow id="Flow_rt2_rpg1" sourceRef="rt2" targetRef="rpg1" />
    <bpmn:sequenceFlow id="Flow_rpg1_rt4" sourceRef="rpg1" targetRef="rt4" />
