<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc19" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc19">
    <bpmn:participant id="Pool_klinik" name="Klinikum" processRef="Process_klinik" />
  </bpmn:collaboration>
  <bpmn:process id="Process_klinik" name="Klinikum" isExecutable="false">
    <bpmn:laneSet id="LaneSet_klinik">
      <bpmn:lane id="Lane_station" name="Station">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_einkauf" name="Einkauf">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_verwaltung" name="Verwaltungsleitung">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Laborbedarf festgestellt">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Bestellformular ausfüllen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:incoming>Flow_t10_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t1_dout0">
        <bpmn:targetRef>d1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="d1" name="Bestellformular (Papier)" dataObjectRef="d1_do" />
    <bpmn:dataObject id="d1_do" />
    <bpmn:task id="t2" name="Formular per Hauspost senden">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Formular ins Bestellsystem abtippen">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_t4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="t3_dout0">
        <bpmn:targetRef>d2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="d2" name="Bestellung (Datensatz)" dataObjectRef="d2_do" />
    <bpmn:dataObject id="d2_do" />
    <bpmn:task id="t4" name="Artikelnummern prüfen">
      <bpmn:incoming>Flow_t3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_t5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Bestellung zur Bestätigung an Station senden">
      <bpmn:incoming>Flow_t4_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_t6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Bestellung nochmals prüfen">
      <bpmn:incoming>Flow_t5_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_t7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Bestätigung an Einkauf zurückschicken">
      <bpmn:incoming>Flow_t6_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t7_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Bestellwert über 500 €?">
      <bpmn:incoming>Flow_t7_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t8</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_g3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t8" name="Freigabe anfordern">
      <bpmn:incoming>Flow_g1_t8</bpmn:incoming>
      <bpmn:outgoing>Flow_t8_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Bestellung freigeben oder ablehnen">
      <bpmn:incoming>Flow_e2_t9</bpmn:incoming>
      <bpmn:outgoing>Flow_t9_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Wöchentliche Freigaberunde">
      <bpmn:incoming>Flow_t8_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_e2_t9</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="Freigabe erteilt?">
      <bpmn:incoming>Flow_t9_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_g3</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_t10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t10" name="Station um Korrektur bitten">
      <bpmn:incoming>Flow_g2_t10</bpmn:incoming>
      <bpmn:outgoing>Flow_t10_t1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3">
      <bpmn:incoming>Flow_g1_g3</bpmn:incoming>
      <bpmn:incoming>Flow_g2_g3</bpmn:incoming>
      <bpmn:outgoing>Flow_g3_t11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t11" name="Bestellung an Lieferanten senden">
      <bpmn:incoming>Flow_g3_t11</bpmn:incoming>
      <bpmn:outgoing>Flow_t11_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Bestellung ausgelöst">
      <bpmn:incoming>Flow_t11_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_t2" sourceRef="t1" targetRef="t2" />
