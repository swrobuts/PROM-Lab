<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc04" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:process id="Process_uc04" name="Triage in der Notaufnahme" isExecutable="false">
    <bpmn:startEvent id="s1" name="Patient eingetroffen">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Vitalparameter erfassen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Dringlichkeit einstufen">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Dringlichkeitsstufe" default="Flow_g1_t5">
      <bpmn:incoming>Flow_t2_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t3</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t4</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Schockraum alarmieren">
      <bpmn:incoming>Flow_g1_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Behandlungsplatz zuweisen">
      <bpmn:incoming>Flow_g1_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="In Wartebereich verweisen">
      <bpmn:incoming>Flow_g1_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2">
      <bpmn:incoming>Flow_t3_g2</bpmn:incoming>
      <bpmn:incoming>Flow_t4_g2</bpmn:incoming>
      <bpmn:incoming>Flow_t5_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Patientenakte anlegen">
      <bpmn:incoming>Flow_g2_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Patient in Behandlung">
      <bpmn:incoming>Flow_t6_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_t2_g1" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_g1_t3" name="rot: lebensbedrohlich" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_g1_t4" name="gelb: dringend" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_g1_t5" name="grün: nicht dringend" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_t3_g2" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_t4_g2" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_t5_g2" sourceRef="t5" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_g2_t6" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_t6_e1" sourceRef="t6" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_uc04">
