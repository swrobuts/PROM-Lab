<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc20s" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc20s">
    <bpmn:participant id="Pool_kunde" name="Kunde" />
    <bpmn:participant id="Pool_betrieb" name="Zerspanungsbetrieb" processRef="Process_betrieb" />
    <bpmn:messageFlow id="Msg_kunde_s1" name="Anfrage" sourceRef="Pool_kunde" targetRef="s1" />
    <bpmn:messageFlow id="Msg_t3_kunde" name="Angebot" sourceRef="t3" targetRef="Pool_kunde" />
    <bpmn:messageFlow id="Msg_kunde_e2" name="Auftragsbestätigung" sourceRef="Pool_kunde" targetRef="e2" />
    <bpmn:messageFlow id="Msg_t14_kunde" name="Lieferung" sourceRef="t14" targetRef="Pool_kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_betrieb" name="Zerspanungsbetrieb" isExecutable="false">
    <bpmn:laneSet id="LaneSet_betrieb">
      <bpmn:lane id="Lane_vertrieb" name="Vertrieb">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_av" name="Arbeitsvorbereitung">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_fertigung" name="Fertigung">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_versand" name="Versand">
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Anfrage im Kundenportal">
      <bpmn:outgoing>Flow_s1_t2</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t2" name="Angebot aus Kalkulationsregeln erzeugen">
      <bpmn:incoming>Flow_s1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="t3" name="Angebot freigeben">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Auftrag im Portal bestätigt">
      <bpmn:incoming>Flow_t3_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_e2_t4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t4" name="Auftrag im ERP anlegen">
      <bpmn:incoming>Flow_e2_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="g1">
      <bpmn:incoming>Flow_t4_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t6</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_g2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t6" name="Arbeitsplan erstellen">
      <bpmn:incoming>Flow_g1_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_g4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Material vorrätig?" default="Flow_g2_g3">
      <bpmn:incoming>Flow_g1_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t7</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_g3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t7" name="Material bestellen">
      <bpmn:incoming>Flow_g2_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t7_e3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="e3" name="Material eingetroffen">
      <bpmn:incoming>Flow_t7_e3</bpmn:incoming>
      <bpmn:outgoing>Flow_e3_g3</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g3">
      <bpmn:incoming>Flow_g2_g3</bpmn:incoming>
      <bpmn:incoming>Flow_e3_g3</bpmn:incoming>
      <bpmn:outgoing>Flow_g3_g4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="g4">
      <bpmn:incoming>Flow_t6_g4</bpmn:incoming>
      <bpmn:incoming>Flow_g3_g4</bpmn:incoming>
      <bpmn:outgoing>Flow_g4_t8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="t8" name="Teile fräsen und entgraten">
      <bpmn:incoming>Flow_g4_t8</bpmn:incoming>
      <bpmn:outgoing>Flow_t8_t10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Maße prüfen und Messprotokoll ablegen">
      <bpmn:incoming>Flow_t8_t10</bpmn:incoming>
      <bpmn:outgoing>Flow_t10_t12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t12" name="Teile verpacken">
      <bpmn:incoming>Flow_t10_t12</bpmn:incoming>
      <bpmn:outgoing>Flow_t12_t13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="t13" name="Lieferschein aus ERP drucken">
      <bpmn:incoming>Flow_t12_t13</bpmn:incoming>
      <bpmn:outgoing>Flow_t13_t14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t14" name="Sendung übergeben">
      <bpmn:incoming>Flow_t13_t14</bpmn:incoming>
      <bpmn:outgoing>Flow_t14_e1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e1" name="Auftrag ausgeliefert">
      <bpmn:incoming>Flow_t14_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t2" sourceRef="s1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_t2_t3" sourceRef="t2" targetRef="t3" />
