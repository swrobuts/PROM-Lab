<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc11" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:process id="Process_uc11" name="Rezeptanfrage in der Apotheke" isExecutable="false">
    <bpmn:startEvent id="s1" name="Kunde legt Rezept vor">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Rezept auf Gültigkeit prüfen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_g1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Präparat vorrätig?">
      <bpmn:incoming>Flow_t1_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t2</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Präparat aus dem Lager holen">
      <bpmn:incoming>Flow_g1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="t3" name="Präparat beim Großhandel bestellen">
      <bpmn:incoming>Flow_g1_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_e2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="e2" name="Kunden über Abholtermin informieren">
      <bpmn:incoming>Flow_t3_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_e2_t4</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="t4" name="Auf Lieferung warten">
      <bpmn:incoming>Flow_e2_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="b1" name="Nach 2 Tagen ohne Lieferung" attachedToRef="t4" cancelActivity="false">
      <bpmn:outgoing>Flow_b1_t5</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="t5" name="Lieferstatus beim Großhandel erfragen">
      <bpmn:incoming>Flow_b1_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_e5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e5" name="Nachfrage erledigt">
      <bpmn:incoming>Flow_t5_e5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2">
      <bpmn:incoming>Flow_t2_g2</bpmn:incoming>
      <bpmn:incoming>Flow_t4_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Kunden beraten">
      <bpmn:incoming>Flow_g2_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_t7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Präparat abgeben und abrechnen">
      <bpmn:incoming>Flow_t6_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t7_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Rezept eingelöst">
      <bpmn:incoming>Flow_t7_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_g1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_g1_t2" name="ja" sourceRef="g1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_g1_t3" name="nein" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_t3_e2" sourceRef="t3" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_e2_t4" sourceRef="e2" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_b1_t5" sourceRef="b1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_t5_e5" sourceRef="t5" targetRef="e5" />
    <bpmn:sequenceFlow id="Flow_t2_g2" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_t4_g2" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_g2_t6" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_t6_t7" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_t7_e1" sourceRef="t7" targetRef="e1" />
  </bpmn:process>
