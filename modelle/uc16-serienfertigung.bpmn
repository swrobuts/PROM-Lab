      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5">
        <dc:Bounds x="1275" y="195" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sp1_di" bpmnElement="sp1" isExpanded="false">
        <dc:Bounds x="1085" y="65" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6">
        <dc:Bounds x="1465" y="65" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d1_di" bpmnElement="d1">
        <dc:Bounds x="1507" y="-15" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1549" y="3" width="109" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1">
        <dc:Bounds x="1697" y="87" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1667" y="129" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_s1_t1_di" bpmnElement="Flow_s1_t1">
        <di:waypoint x="213" y="105" />
        <di:waypoint x="325" y="105" />
      </bpmndi:BPMNEdge>
