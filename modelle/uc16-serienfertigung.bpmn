        <di:waypoint x="635" y="105" />
        <di:waypoint x="705" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_t3_g1_di" bpmnElement="Flow_t3_g1">
        <di:waypoint x="825" y="105" />
        <di:waypoint x="930" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g1_sp1_di" bpmnElement="Flow_g1_sp1">
        <di:waypoint x="980" y="105" />
