        <bpmndi:BPMNLabel>
          <dc:Bounds x="355" y="236" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="515" y="65" width="120" height="80" />
