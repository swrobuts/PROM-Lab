<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc02" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:process id="Process_uc02" name="Blutentnahme in der Hausarztpraxis" isExecutable="false">
    <bpmn:startEvent id="s1" name="Patient aufgerufen">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Identität prüfen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Röhrchen etikettieren">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Blut entnehmen">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_t4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Einstichstelle versorgen">
      <bpmn:incoming>Flow_t3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_t5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Proben für Labor verpacken">
      <bpmn:incoming>Flow_t4_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_e1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Proben versandbereit">
      <bpmn:incoming>Flow_t5_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_t1_t2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_t2_t3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_t3_t4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_t4_t5" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_t5_e1" sourceRef="t5" targetRef="e1" />
  </bpmn:process>
