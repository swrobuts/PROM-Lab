<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_uc18f" targetNamespace="https://thws.de/prom-lab" exporter="PROM-Lab gen_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_uc18f">
    <bpmn:participant id="Pool_gast" name="Gast" processRef="Process_gast" />
    <bpmn:participant id="Pool_rest" name="Restaurant" processRef="Process_rest" />
    <bpmn:messageFlow id="Msg_rt4_rt2" name="Nachricht an Küche" sourceRef="rt4" targetRef="rt2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_gast" name="Gast" isExecutable="false">
    <bpmn:startEvent id="gs" name="Essen kalt">
      <bpmn:outgoing>Flow_gs_gt1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="gt1" name="Reklamation">
      <bpmn:incoming>Flow_gs_gt1</bpmn:incoming>
      <bpmn:outgoing>Flow_gt1_rs</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ge" />
    <bpmn:sequenceFlow id="Flow_gs_gt1" sourceRef="gs" targetRef="gt1" />
    <bpmn:sequenceFlow id="Flow_gt1_rs" sourceRef="gt1" targetRef="rs" />
  </bpmn:process>
  <bpmn:process id="Process_rest" name="Restaurant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_rest">
      <bpmn:lane id="Lane_service" name="Service">
        <bpmn:flowNodeRef>rs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>re</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_kueche" name="Küche">
        <bpmn:flowNodeRef>rt2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="rs">
      <bpmn:outgoing>Flow_rs_rt1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="rt1" name="Wird geprüft">
      <bpmn:incoming>Flow_rs_rt1</bpmn:incoming>
      <bpmn:outgoing>Flow_rt1_rg1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="rg1">
      <bpmn:incoming>Flow_rt1_rg1</bpmn:incoming>
      <bpmn:outgoing>Flow_rg1_rt4</bpmn:outgoing>
      <bpmn:outgoing>Flow_rg1_rt3</bpmn:outgoing>
      <bpmn:outgoing>Flow_rg1_rt2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="rt2" name="Gericht neu zubereiten">
      <bpmn:incoming>Flow_rg1_rt2</bpmn:incoming>
      <bpmn:outgoing>Flow_rt2_rg2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="rt3" name="Gutschein ausstellen">
      <bpmn:incoming>Flow_rg1_rt3</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="rt4" name="Gast beruhigen">
      <bpmn:incoming>Flow_rg1_rt4</bpmn:incoming>
      <bpmn:outgoing>Flow_rt4_rg2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="rg2">
      <bpmn:incoming>Flow_rt4_rg2</bpmn:incoming>
      <bpmn:incoming>Flow_rt2_rg2</bpmn:incoming>
      <bpmn:outgoing>Flow_rg2_rt5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="rt5" name="Gericht servieren">
      <bpmn:incoming>Flow_rg2_rt5</bpmn:incoming>
      <bpmn:outgoing>Flow_rt5_re</bpmn:outgoing>
      <bpmn:outgoing>Flow_rt5_ge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="re" name="Gast zufrieden">
      <bpmn:incoming>Flow_rt5_re</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_rs_rt1" sourceRef="rs" targetRef="rt1" />
    <bpmn:sequenceFlow id="Flow_rt1_rg1" sourceRef="rt1" targetRef="rg1" />
    <bpmn:sequenceFlow id="Flow_rg1_rt4" sourceRef="rg1" targetRef="rt4" />
    <bpmn:sequenceFlow id="Flow_rg1_rt3" sourceRef="rg1" targetRef="rt3" />
    <bpmn:sequenceFlow id="Flow_rg1_rt2" sourceRef="rg1" targetRef="rt2" />
    <bpmn:sequenceFlow id="Flow_rt4_rg2" sourceRef="rt4" targetRef="rg2" />
    <bpmn:sequenceFlow id="Flow_rt2_rg2" sourceRef="rt2" targetRef="rg2" />
    <bpmn:sequenceFlow id="Flow_rg2_rt5" sourceRef="rg2" targetRef="rt5" />
    <bpmn:sequenceFlow id="Flow_rt5_re" sourceRef="rt5" targetRef="re" />
    <bpmn:sequenceFlow id="Flow_rt5_ge" sourceRef="rt5" targetRef="ge" />
  </bpmn:process>
